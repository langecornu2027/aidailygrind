# /etc/systemd/system/aidailygrind-mailer.service
# Small web API for subscribe / confirm / unsubscribe and the AI voice (deploy/mailer.py)
[Unit]
Description=The AI Daily Grind email subscriptions
After=network-online.target

[Service]
User=aidailygrind
Group=aidailygrind
EnvironmentFile=/etc/aidailygrind/env
ExecStart=/usr/bin/python3 /opt/aidailygrind/mailer.py serve 8787
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aidailygrind /var/www/aidailygrind/audio

[Install]
WantedBy=multi-user.target
